# se encarga de descargar paquetes y descomprimirlos
fn getPkg {
	echo "[Downloading Package...]"
	let url = $0
	let command = "curl " + url + " > pkg.zip"
	system(command)
}

fn extractPkg {
	echo "[Extracting Package...]"
	let com = "unzip pkg.zip" #siempre es un pkg.zip, o no viste getPkg
	system(com)
}

